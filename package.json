{
  "name": "oppo-live-pic-tool",
  "version": "0.5.0",
  "description": "Inspect and losslessly split compatible JPEG motion photos",
  "type": "module",
  "bin": {
    "oppo-live": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md",
    "ITERATION.md",
    "test/test-img/README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "dev": "node --import tsx src/cli.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "check": "tsc --noEmit",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "commander": "^14.0.3",
    "fast-xml-parser": "^5.11.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lenuxo/oppo-live-pic-tool.git"
  },
  "homepage": "https://github.com/lenuxo/oppo-live-pic-tool#readme",
  "bugs": {
    "url": "https://github.com/lenuxo/oppo-live-pic-tool/issues"
  }
}
